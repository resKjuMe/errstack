{
    "$schema": "https://json.schemastore.org/prettierrc.json",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.md"],
            "options": {
                "proseWrap": "preserve"
            }
        }
    ]
}
