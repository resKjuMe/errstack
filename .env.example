APP_NAME=Errstack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting: lokal der selbst gehostete Reverb (php artisan reverb:start),
# in der Produktion wahlweise "pusher" mit den Cloud-Zugangsdaten.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=errstack
REVERB_APP_KEY=errstack-local
REVERB_APP_SECRET=errstack-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=eu

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="errstack@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Öffentliche Schnittstelle (/api/0/)
# SANCTUM_TOKEN_PREFIX=errstack_
# API_RATE_LIMIT=60

# Datenaufnahme (/api/<projekt-id>/store/)
# Größenschranken einer einzelnen Meldung in Byte: einmal für den noch
# gepackten Rumpf, einmal für den entpackten Inhalt. Vorgabe je 1 MiB wie bei
# Sentry; größere Meldungen brauchen beide Werte.
# INGEST_MAX_REQUEST_BYTES=1048576
# INGEST_MAX_PAYLOAD_BYTES=1048576

# Datenaufnahme (/api/<projekt-id>/envelope/)
# Ein Envelope bündelt mehrere Elemente und trägt oft einen Anhang mit sich —
# darum eigene, höhere Grenzen. MAX_ITEMS begrenzt die Zahl der Elemente,
# MAX_ITEM_BYTES ein einzelnes JSON-Element, MAX_ATTACHMENT_BYTES einen Anhang
# oder eine Aufzeichnung. Ein zu großes Element wird verworfen und gezählt; nur
# ein zu großer Envelope im Ganzen wird abgewiesen.
# INGEST_ENVELOPE_MAX_REQUEST_BYTES=20971520
# INGEST_ENVELOPE_MAX_PAYLOAD_BYTES=104857600
# INGEST_ENVELOPE_MAX_ITEMS=100
# INGEST_ENVELOPE_MAX_ITEM_BYTES=1048576
# INGEST_ENVELOPE_MAX_ATTACHMENT_BYTES=20971520

# Antwortzeiten
# Wie viele Einzelschritte (Spans) je Transaktion abgelegt werden. Die Grenze
# fängt den Regelfall auf, nicht den Angriff: eine Anwendung mit einer
# N+1-Abfrage meldet für einen einzigen Aufruf Zehntausende gleichartige
# Schritte. Was darüber hinausgeht, wird gezählt und protokolliert.
# INGEST_MAX_SPANS=1000

# Selbstüberwachung
# Errstack meldet seine eigenen Fehler an eine Errstack-Installation. Der Wert
# ist ein DSN, wie ihn die Oberfläche beim Projekt anzeigt; Rechner, Schema und
# Projekt-Nummer stecken darin, ein getrennter Host-Eintrag entfällt.
#
# Leer bedeutet: es wird nichts gemeldet. Das ist die Vorgabe.
#
# Sinnvoll ist ein DSN, der auf eine **zweite** Installation zeigt. Zeigt er auf
# dieselbe, kann sie ihren eigenen Ausfall nicht melden — genau dann fällt auch
# der Empfänger aus.
# ERRSTACK_DSN=

# Anteil der Aufrufe, die als Antwortzeit-Messung mitgeschickt werden (0.0–1.0).
# Ohne Angabe bleibt das Tracing aus. Die Routen der Datenaufnahme sind davon
# ausgenommen, damit sich das Melden nicht selbst hochschaukelt.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Ob Nutzerdaten (Adresse, Konto, Kopfzeilen) mitgeschickt werden. Aus, weil in
# den Fehlern dieser Anwendung die Meldungen **fremder** Anwendungen stecken.
# SENTRY_SEND_DEFAULT_PII=false

# Anteil der Aufrufe, für die zusätzlich ein Profil aufgezeichnet wird — welche
# Funktionen die Rechenzeit verbrauchen (M4). Der Anteil zählt innerhalb der
# gemessenen Aufrufe: ohne Tracing (oben) passiert hier nichts. Braucht die
# PHP-Erweiterung `excimer`; fehlt sie, bleibt es still aus.
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Welche Auslieferung läuft (R1). Ohne Angabe zählt eine Datei `VERSION` im
# Wurzelverzeichnis — `git rev-parse --short HEAD > VERSION` im Deploy-Skript
# genügt und wandert mit dem ausgelieferten Stand.
# SENTRY_RELEASE=

# Die Oberfläche meldet mit: Browserfehler und Ladeerlebnis (Web Vitals) aus der
# React-Anwendung. Das SDK wird erst nachgeladen, wenn oben eine DSN steht.
# ERRSTACK_BROWSER_ENABLED=true
# ERRSTACK_BROWSER_TRACES_SAMPLE_RATE=0.2

# Sicherheitsberichte des Browsers (CSP-Verstöße, M7). Ausgeliefert wird
# `Content-Security-Policy-Report-Only`: die Regel meldet, sie blockiert nicht.
# ERRSTACK_CSP_REPORTS_ENABLED=true

# Lebenszeichen des eigenen Zeitplans. `ERRSTACK_SCHEDULE_MONITOR` ist die
# Kennung, unter der er auf der empfangenden Installation als überwachter
# Cronjob angelegt sein muss — ohne ihn wird das Lebenszeichen angenommen und
# niemandem zugeordnet.
# ERRSTACK_SCHEDULE_CHECKINS_ENABLED=true
# ERRSTACK_SCHEDULE_MONITOR=zeitplan

# Betrieb der eigenen Installation
# Nicht zu verwechseln mit der Selbstüberwachung oben: die meldet die eigenen
# Fehler nach draußen, hier geht es um den Zustand *dieser* Installation.
# Ausführlich in docs/betrieb.md.
#
# Ab welcher Antwortzeit eine Zustandsprüfung als gescheitert gilt, und auf
# welcher Ablage zur Probe geschrieben wird.
# ERRSTACK_HEALTH_SLOW_MS=2000
# ERRSTACK_HEALTH_DISK=local

# Der maschinenlesbare Kennzahl-Endpunkt (/metrics, Prometheus-Format). Aus,
# weil er Rückstände und Laufzeiten nennt — also sagt, wann diese Installation
# überlastet ist. Im offenen Netz gehört ein Token dazu.
# ERRSTACK_METRICS_ENABLED=false
# ERRSTACK_METRICS_TOKEN=
# ERRSTACK_METRICS_PREFIX=errstack

# Ab wann der Rückstand gemeldet wird. Zwei Schwellen, weil einzeln keine
# trägt — die Menge schlägt bei jedem Ansturm an, das Alter bleibt bei einer
# einzelnen alten Meldung still. Gewarnt wird erst, wenn eine von beiden
# `GRACE_MINUTES` lang ununterbrochen überschritten bleibt.
# ERRSTACK_BACKLOG_MAX_PENDING=1000
# ERRSTACK_BACKLOG_MAX_AGE_SECONDS=300
# ERRSTACK_BACKLOG_GRACE_MINUTES=5
# ERRSTACK_BACKLOG_REPEAT_MINUTES=60
# ERRSTACK_BACKLOG_LOG_CHANNEL=

# Wer die Betriebsansicht sehen darf: E-Mail-Adressen, durch Komma getrennt.
# Leer heißt: die Besitzer einer Organisation. Das ist die Vorgabe für die
# übliche Installation mit einer einzigen Organisation; bei mehreren gehört die
# Liste gesetzt — ein Besitzer ist dann gerade nicht der Betreiber.
# ERRSTACK_OPERATORS=
